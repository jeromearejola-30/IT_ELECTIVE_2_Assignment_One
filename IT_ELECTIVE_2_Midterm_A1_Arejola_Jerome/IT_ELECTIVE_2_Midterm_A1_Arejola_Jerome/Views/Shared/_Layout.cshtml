<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Portfolio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap Icons Link -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Navigation Panel -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse position-fixed start-0 top-0 bottom-0 text-white z-1">
                <div class="position-sticky pt-3 px-3">
                    <h4 class="py-3 text-center border-bottom border-secondary">My Portfolio</h4>
                    <ul class="nav flex-column mt-3">
                        <li class="nav-item mb-2"><a class="nav-link text-white" href="#home"><i class="bi bi-house-door me-2"></i>Home</a></li>
                        <li class="nav-item mb-2"><a class="nav-link text-white" href="#about"><i class="bi bi-person me-2"></i>About Me</a></li>
                        <li class="nav-item mb-2"><a class="nav-link text-white" href="#skills"><i class="bi bi-code-slash me-2"></i>Skills</a></li>
                        <li class="nav-item mb-2"><a class="nav-link text-white" href="#projects"><i class="bi bi-briefcase me-2"></i>Projects</a></li>
                        <li class="nav-item mb-2"><a class="nav-link text-white" href="#contact"><i class="bi bi-envelope me-2"></i>Contact</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Right Side Main Content View -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 offset-md-3 offset-lg-2">
                <!-- Mobile Only Navbar Header -->
                <div class="d-md-none bg-dark text-white p-3 d-flex justify-content-between align-items-center sticky-top">
                    <span class="fs-5 fw-bold">Portfolio</span>
                    <button class="btn btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                @RenderBody()

                <footer class="text-center py-4 my-4 border-top text-muted">
                    &copy; 2026 - @ViewData["Title"] Portfolio Project
                </footer>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>