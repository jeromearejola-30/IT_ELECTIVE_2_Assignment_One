
<section id="home" class="d-flex align-items-center bg-light min-vh-100">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start">
                <h1 class="display-3 fw-bold text-dark">@ViewData["FullName"]</h1>
                <h3 class="text-primary mb-4">@ViewData["JobTitle"]</h3>
                <p class="lead text-muted mb-4">@ViewData["Bio"]</p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <a asp-controller="Home" asp-action="Projects" class="btn btn-primary btn-lg px-4 me-md-2">View Projects</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-lg px-4">Contact Me</a>
                </div>
            </div>
            <div class="col-lg-5 text-center mt-5 mt-lg-0">
                <img src="@ViewData["ProfileImg"]" class="img-fluid rounded-circle shadow-lg border border-4 border-white" alt="Profile pic" />
            </div>
        </div>
    </div>
</section>